{
  "name": "atlas-of-a-life",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run generate && vite --host 127.0.0.1",
    "generate": "tsx scripts/build-geo.ts && tsx scripts/build-style.ts",
    "build": "npm run generate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "geocode": "tsx scripts/geocode.ts",
    "basemap:build": "bash scripts/build-basemap.sh",
    "tiles:publish": "tsx scripts/publish-tiles.ts",
    "analyze": "ANALYZE=1 npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "verify": "node verification/entry.mjs",
    "record": "tsx scripts/record.ts",
    "verify:approve": "tsx verification/approve.ts",
    "verify:hosting": "tsx verification/hosting.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "@playwright/test": "1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.5.1",
    "@types/pngjs": "6.0.5",
    "@types/polylabel": "2.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "fast-check": "4.10.0",
    "mapshaper": "0.7.61",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "polylabel": "2.1.0",
    "rollup-plugin-visualizer": "7.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
