# Copy to .env.local. Remote production requires your published immutable archive.
VITE_BASEMAP=remote
VITE_BASEMAP_URL=
# Include each exact redirect origin measured by verify:hosting, space-separated.
VITE_TILE_ORIGINS=
VITE_BASE=./
# Use VITE_BASEMAP=bundled for the local archive produced by basemap:build.
